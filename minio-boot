#!/bin/sh
# Start MinIO and make sure Safebucket's bucket exists, in one service.
#
# Safebucket refuses to boot if its bucket is missing (it fatals on
# BucketExists=false), and upstream's minio image exits with a help screen
# unless given a server command. Railway templates can't run one-shot init
# containers cleanly, so both are baked in here — no startCommand, no init
# service.
set -eu

: "${MINIO_ROOT_USER:?MINIO_ROOT_USER is required}"
: "${MINIO_ROOT_PASSWORD:?MINIO_ROOT_PASSWORD is required}"

BUCKET="${SAFEBUCKET_S3_BUCKET:-safebucket}"
DATA="${MINIO_DATA_DIR:-/data}"
LISTEN_PORT="${PORT:-9000}"

# mc writes its config to $HOME, which is not reliably writable on a mounted
# volume, so keep it on the container filesystem.
export MC_CONFIG_DIR=/tmp/.mc

mkdir -p "$DATA"
# The pgsty fork renamed its server binary from minio to silo on 2026-08-06
# (same S3 protocol, same on-disk format). Prefer silo, fall back to minio.
SERVER=silo
command -v silo >/dev/null 2>&1 || SERVER=minio
"$SERVER" server "$DATA" --address ":$LISTEN_PORT" &
MINIO_PID=$!

attempt=0
until mc alias set local "http://127.0.0.1:$LISTEN_PORT" \
  "$MINIO_ROOT_USER" "$MINIO_ROOT_PASSWORD" >/dev/null 2>&1; do
  attempt=$((attempt + 1))
  if [ "$attempt" -gt 60 ]; then
    echo "minio-boot: server did not become reachable within 60s" >&2
    exit 1
  fi
  sleep 1
done

mc mb --ignore-existing "local/$BUCKET" >/dev/null
mc anonymous set none "local/$BUCKET" >/dev/null
echo "minio-boot: bucket $BUCKET ready on :$LISTEN_PORT"

wait "$MINIO_PID"
